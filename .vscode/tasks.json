{
    // See https://go.microsoft.com/fwlink/?LinkId=733558
    // for the documentation about the tasks.json format
    "version": "2.0.0",
    "tasks": [
        /**
         * Main task - Serve the UserFrosting instance
         */
        {
            "label": "==> Serve",
            "dependsOn": [
                "Bakery Serve",
                "Vite Dev"
            ],
            "problemMatcher": []
        },

        /**
         * Workspace NPM Tasks
         */
        {
            "label": "npm install",
            "type": "shell",
            "command": "npm install"
        },
        {
            "label": "npm update",
            "type": "shell",
            "command": "npm update"
        },
        {
            "label": "Format",
            "type": "shell",
            "command": "npm run format"
        },
        {
            "label": "Type Check",
            "type": "shell",
            "command": "npm run typecheck"
        },
        {
            "label": "Eslint",
            "type": "shell",
            "command": "npm run lint"
        },
        {
            "label": "Tests",
            "type": "shell",
            "command": "npm run test"
        },
        {
            "label": "Coverage",
            "type": "shell",
            "command": "npm run coverage"
        },
        {
            "label": "Vite Dev",
            "type": "shell",
            "command": "npm run vite:dev",
            "isBackground": true
        },
        {
            "label": "Build",
            "type": "shell",
            "command": "npm run build"
        },
        {
            "label": "Build - Skeleton",
            "type": "shell",
            "command": "npm run --workspace=userfrosting vite:build"
        },

        /**
         * Workspace PHP Tasks
         */
        {
            "label": "Bakery Serve",
            "type": "shell",
            "command": "php bakery serve",
            "isBackground": true
        },
        {
            "label": "Composer Update",
            "type": "shell",
            "command": "composer update"
        },
        {
            "label": "Merge composer.json",
            "type": "shell",
            "command": "vendor/bin/monorepo-builder merge"
        },
        {
            "label": "Composer Validate",
            "type": "shell",
            "command": "vendor/bin/monorepo-builder validate"
        },
        {
            "label": "PHPUnit",
            "type": "shell",
            "options": {
                "env": {
                    "XDEBUG_CONFIG": "idekey=VSCODE"
                }
            },
            "command": "vendor/bin/phpunit --stop-on-failure --stop-on-error",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "clear": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "PHP CS Fixer",
            "type": "shell",
            "command": "vendor/bin/php-cs-fixer fix"
        },
        {
            "label": "PHPStan",
            "type": "shell",
            "command": "printf '\\33c\\e[3J' && vendor/bin/phpstan analyse"
        },
        {
            "label": "Update PHP Headers",
            "type": "shell",
            "command": [
                "vendor/bin/php-cs-fixer fix --config packages/framework/.php-cs-fixer.php &&",
                "vendor/bin/php-cs-fixer fix --config packages/sprinkle-account/.php-cs-fixer.php &&",
                "vendor/bin/php-cs-fixer fix --config packages/sprinkle-admin/.php-cs-fixer.php &&",
                "vendor/bin/php-cs-fixer fix --config packages/sprinkle-core/.php-cs-fixer.php"
            ],
        },

        /**
         * Docker Tasks
         */
        {
            "label": "Docker - Build",
            "type": "shell",
            "command": "docker compose build --no-cache"
        },
        {
            "label": "Docker - Up",
            "type": "shell",
            "command": "docker compose up -d"
        },
        {
            "label": "Docker - Open Mailpit",
            "type": "shell",
            "command": "open",
            "args": [
                "http://localhost:8025"
            ],
            "linux": {
                "command": "xdg-open"
            },
            "windows": {
                "command": "cmd",
                "args": [
                    "/c",
                    "start",
                    "",
                    "http://localhost:8025"
                ]
            }
        },
        {
            "label": "Docker - Stop",
            "type": "shell",
            "command": "docker compose stop"
        },
        {
            "label": "Docker - Composer Update",
            "type": "shell",
            "command": "docker compose exec app composer update"
        },
        {
            "label": "Docker - Bakery Bake",
            "type": "shell",
            "command": "docker compose exec app php bakery bake"
        },
        {
            "label": "Docker - PHPUnit",
            "type": "shell",
            "command": "docker compose exec app vendor/bin/phpunit",
            "presentation": {
                "clear": true,
                "panel": "dedicated"
            }
        },
        {
            "label": "Docker - Compose Config Test",
            "type": "shell",
            "command": "vendor/bin/phpunit --no-coverage --no-logging docker/tests/ComposeConfigTest.php"
        },
        {
            "label": "Docker - PHP CS Fixer",
            "type": "shell",
            "command": "docker compose exec app vendor/bin/php-cs-fixer fix"
        },
        {
            "label": "Docker - PHPStan",
            "type": "shell",
            "command": "docker compose exec app vendor/bin/phpstan analyse"
        },
        {
            "label": "Docker - Shell (App)",
            "type": "shell",
            "command": "docker compose exec app bash",
            "isBackground": true,
            "runOptions": {
                "instanceLimit": 99
            },
            "presentation": {
                "panel": "new",
                "close": true,
                "showReuseMessage": false
            }
        }
    ]
}